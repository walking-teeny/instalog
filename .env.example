# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend server (server.ts) ---
# PORT: port the Express API + (in production) the built frontend are served on.
PORT=8787

# POSTGRES_URL: connection string for the Postgres database (Vercel Postgres,
# Neon, Supabase, or any standard Postgres). On Vercel, adding the "Postgres"
# storage integration sets this automatically. For local dev, run
# `vercel env pull .env.local` after adding it, or point at any Postgres you
# have (e.g. a free Neon project).
POSTGRES_URL="postgres://user:password@host:5432/dbname"

# JWT_SECRET: signs login tokens. Set a long random value in production.
JWT_SECRET="change-me-to-a-long-random-string"

# ADMIN_USERNAME / ADMIN_PASSWORD: used once to create the first login account
# if the users table is empty. Change the password after first login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
